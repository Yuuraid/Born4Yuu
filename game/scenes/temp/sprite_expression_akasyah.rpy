label sprite_animation_akasyah:

    "akasyah"

    show akasyah netral
    "testing expression: netral"

    show akasyah angry
    "testing expression: angry"

    show akasyah smug
    "testing expression: smug"

    show akasyah hurt
    "testing expression: hurt"

    hide akasyah

    show akasyah angry eff_angry
    "testing effects: angry"
    
    show akasyah netral eff_laugh
    "testing effects: happy"

    show akasyah netral eff_surprise_y
    "testing effects: surpised"

    show akasyah netral eff_sweat_w
    "testing effects: sweat"

    show akasyah netral eff_exclamation
    "testing effects: exclamation"

    show akasyah netral eff_question_mark
    "testing effects: question mark"

    show akasyah netral eff_sleepy
    "testing effects: sleepy"

    show akasyah netral eff_snot
    "testing effects: snot"

    hide akasyah

    "akasyah full"

    show akasyah full_netral:
        zoom 1.0
    "testing expression: netral"

    show akasyah full_angry
    "testing expression: angry"

    show akasyah full_smug
    "testing expression: sad"

    show akasyah full_hurt
    "testing expression: hurt"

    hide akasyah

    show akasyah full_angry eff_angry:
        zoom 2.0
    "testing effects: angry"
    
    show akasyah full_netral eff_laugh
    "testing effects: happy"

    show akasyah full_netral eff_surprise_y
    "testing effects: surpised"

    show akasyah full_netral eff_sweat_w
    "testing effects: sweat"

    show akasyah full_netral eff_exclamation
    "testing effects: exclamation"

    show akasyah full_netral eff_question_mark
    "testing effects: question mark"

    show akasyah full_netral eff_sleepy
    "testing effects: sleepy"

    show akasyah full_netral eff_snot
    "testing effects: snot"

    hide akasyah

    pause

    return